{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Havit MS966WB Battery Monitor",
  "mainBinaryName": "hmbm",
  "version": "1.0.0",
  "identifier": "io.github.havitms966wb.batterymonitor",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Havit MS966WB Battery Monitor",
        "width": 430,
        "height": 850,
        "minWidth": 390,
        "minHeight": 600,
        "resizable": false,
        "maximizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
